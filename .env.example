# Dayflow Environment Configuration Example
PROJECT_NAME="Dayflow HR Platform"
ENV="development"
SECRET_KEY="dayflow-super-secret-key-change-in-production-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Configuration
# Natively uses PostgreSQL, auto-falls back to sqlite:///./dayflow.db if Postgres is unreachable
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dayflow"

# AI Copilot Configuration (Optional - Dayflow uses deterministic fallback if missing)
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# CORS Setup
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"
